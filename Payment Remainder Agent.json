      "parameters": {
        "jsCode": "const today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst matchingRows = [];\n\nfor (const item of $input.all()) {\n    const dueDate = new Date(item.json[\"Due Date\"]);\n    dueDate.setHours(0, 0, 0, 0);\n\n    if (dueDate.getTime() === today.getTime()) {\n        matchingRows.push(item);\n    }\n}\n\nreturn matchingRows;"
